# ─── Supabase ────────────────────────────────────────────
# احصل على هذه القيم من: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE

# الرابط الرسمي للموقع، بدون شرطة مائلة في النهاية
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN.example

# Server only: never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
INTAKE_RATE_LIMIT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
INTAKE_LINK_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=NetExpert <notifications@YOUR_VERIFIED_DOMAIN.example>
